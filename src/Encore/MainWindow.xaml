<Window x:Class="Encore.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:local="clr-namespace:Encore.Controls" Title="Encore · Your voice, center stage" Width="1360" Height="900" MinWidth="900" MinHeight="560" Background="{StaticResource Background}" Foreground="{StaticResource Text}" FontFamily="Segoe UI" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" PreviewKeyDown="OnKeyDown" Closing="OnClosing" AllowDrop="True" Drop="OnDrop">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="#141419" BorderBrush="#29272E" BorderThickness="0,0,0,1">
      <Grid Margin="20,0,8,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="E N C O R E" FontSize="10" FontWeight="Bold" Foreground="#C4BFC8"/><TextBlock Text=" /  YOUR VOICE, CENTER STAGE" FontSize="9" Foreground="#686574" Margin="12,0,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Content="─" Style="{StaticResource QuietButton}" Width="42" Click="Minimize_Click" ToolTip="Minimize"/><Button Content="□" Style="{StaticResource QuietButton}" Width="42" Click="Maximize_Click" ToolTip="Maximize or restore"/><Button Content="×" Style="{StaticResource QuietButton}" FontSize="20" Width="42" Click="Close_Click" ToolTip="Close Encore"/></StackPanel></Grid>
    </Border>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="208"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border x:Name="Sidebar" Background="#15151C" BorderBrush="#292730" BorderThickness="0,0,1,0">
        <Grid><Grid.RowDefinitions><RowDefinition Height="112"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition x:Name="SidebarFooterRow" Height="178"/></Grid.RowDefinitions>
          <StackPanel Margin="25,31,0,0"><StackPanel Orientation="Horizontal"><local:LogoMark Width="28" Height="32" Margin="0,0,10,0"/><TextBlock Text="encore" FontSize="27" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel><TextBlock Text="MAKE IT YOUR MOMENT" FontSize="9" Foreground="#797582" Margin="0,9,0,0"/></StackPanel>
          <StackPanel Grid.Row="1"><TextBlock Text="Y O U R  S P A C E" FontSize="9" Foreground="#6E697B" Margin="27,8,0,13"/>
            <Button x:Name="LibraryNav" Style="{StaticResource NavButton}" Click="Library_Click"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8F1;" Margin="0,0,13,0"/><TextBlock Text="Song library"/></StackPanel></Button>
            <Button x:Name="StageNav" Style="{StaticResource NavButton}" Click="Stage_Click"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE720;" Margin="0,0,13,0"/><TextBlock Text="The stage"/></StackPanel></Button>
            <Button x:Name="HistoryNav" Style="{StaticResource NavButton}" Click="History_Click"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D9;" Margin="0,0,13,0"/><TextBlock Text="Your performances" FontSize="13"/></StackPanel></Button>
            <Border Height="1" Background="#2D2935" Margin="27,21"/>
            <Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Click="Settings_Click"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" Margin="0,0,13,0"/><TextBlock Text="Studio setup"/></StackPanel></Button>
          </StackPanel>
          <Border x:Name="SidebarNote" Grid.Row="3" Background="#1E1D26" CornerRadius="12" Margin="18,0,18,23" Padding="15"><StackPanel><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="#91D9B4" Margin="0,0,7,0"/><TextBlock Text="ALL YOURS. ALL OFFLINE." FontSize="9" Foreground="#B3B0BF" FontWeight="SemiBold"/></StackPanel><TextBlock Text="A little courage.&#x0a;A lot of possibility." FontSize="15" Margin="0,13,0,9" LineHeight="22"/><TextBlock Text="No account. Just your voice." FontSize="10" Foreground="#868091"/><TextBlock Text="ENCORE  1.0" FontSize="8" Foreground="#635C71" Margin="0,17,0,0"/></StackPanel></Border>
        </Grid>
      </Border>
      <Grid Grid.Column="1" Margin="30,24,30,18" x:Name="ContentRoot">
        <Grid x:Name="LibraryView">
          <Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition x:Name="HeroRow" Height="210"/><RowDefinition Height="65"/><RowDefinition Height="*"/><RowDefinition Height="37"/></Grid.RowDefinitions>
          <Grid><StackPanel><TextBlock Text="Y O U R  S T A G E  A W A I T S" Style="{StaticResource Eyebrow}"/><TextBlock Text="Song library" FontSize="30" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><Button Content="＋  Add song folder" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,0,0" Click="AddFolder_Click" ToolTip="Add a folder containing local song charts and audio"/></Grid>
          <Border x:Name="HeroPanel" Grid.Row="1" CornerRadius="16" ClipToBounds="True"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#3D253C" Offset="0"/><GradientStop Color="#2D232F" Offset=".50"/><GradientStop Color="#22212D" Offset="1"/></LinearGradientBrush></Border.Background><Grid><local:HeroArt HorizontalAlignment="Right" Width="460"/><StackPanel Margin="28,21"><TextBlock Text="YOUR VOICE. CENTER STAGE." FontSize="9" Foreground="#E4ADBA"/><TextBlock x:Name="HeroTitle" Text="Find your voice.&#x0a;Own the spotlight." FontSize="29" FontWeight="SemiBold" LineHeight="33" LineStackingStrategy="BlockLineHeight" Margin="0,8,0,0"/><TextBlock x:Name="HeroDescription" Text="Pick a song. Follow the melody. Make it yours." FontSize="12" Foreground="#C4B5C7" Margin="0,8,0,0"/><Button Content="Take the stage  →" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,15,0,0" Padding="17,9" Click="Sing_Click"/></StackPanel><Border VerticalAlignment="Top" HorizontalAlignment="Right" CornerRadius="12" Background="#31303B" Padding="10,5" Margin="0,17,19,0"><TextBlock Text="●  100% OFFLINE" FontSize="9" Foreground="#C8DACB"/></Border></Grid></Border>
          <Grid Grid.Row="2" Margin="0,18,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid><TextBox x:Name="SearchBox" TextChanged="Search_Changed" Padding="35,10,12,10" AutomationProperties.Name="Search songs"/><TextBlock Text="Search songs or artists" Foreground="#7F7A8C" IsHitTestVisible="False" VerticalAlignment="Center" Margin="36,0,0,0" x:Name="SearchPlaceholder"/><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" Foreground="#898393" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid><Button x:Name="FavoritesFilter" Grid.Column="1" Content="♡  Favorites" Margin="10,0,0,0" Padding="13,9" Click="Favorites_Click"/><ComboBox x:Name="SortBox" Grid.Column="2" Width="132" Margin="10,0,0,0" SelectionChanged="Sort_Changed" SelectedIndex="0"><ComboBoxItem Content="Title A–Z"/><ComboBoxItem Content="Artist A–Z"/><ComboBoxItem Content="Best score"/></ComboBox></Grid>
          <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="262"/></Grid.ColumnDefinitions>
            <Grid Margin="0,0,20,0"><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><TextBlock x:Name="SongCountText" Text="YOUR COLLECTION" FontSize="9" Foreground="#8B8495" VerticalAlignment="Center"/><TextBlock Text="BEST" FontSize="9" Foreground="#8B8495" HorizontalAlignment="Right" Margin="0,0,82,0" VerticalAlignment="Center"/></Grid>
              <ListBox x:Name="SongList" Grid.Row="1" SelectionChanged="Song_Changed" MouseDoubleClick="Song_DoubleClick" ItemsSource="{Binding SongRows}" AutomationProperties.Name="Song library"><ListBox.ItemTemplate><DataTemplate><Grid Margin="13,12"><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/><ColumnDefinition Width="55"/><ColumnDefinition Width="37"/></Grid.ColumnDefinitions><local:AlbumArt Width="48" Height="48" Seed="{Binding Title}" CoverPath="{Binding CoverPath}"/><StackPanel Grid.Column="1" Margin="12,0,5,0" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle}" Foreground="#96909F" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="{Binding BestLabel}" FontSize="16" Foreground="{StaticResource Lavender}" HorizontalAlignment="Center"/><TextBlock Text="{Binding Duration}" FontSize="10" Foreground="#827C8D" Margin="0,4,0,0" HorizontalAlignment="Center"/></StackPanel><Button Grid.Column="3" Content="{Binding FavoriteGlyph}" Style="{StaticResource QuietButton}" Padding="3" FontSize="20" Click="FavoriteSong_Click" ToolTip="Favorite this song"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
              <StackPanel Grid.Row="1" x:Name="EmptyLibrary" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="A new song is a new possibility." FontSize="17" HorizontalAlignment="Center"/><TextBlock Text="Add a song folder or try a different search." Foreground="{StaticResource Muted}" Margin="0,8,0,16" HorizontalAlignment="Center"/><Button Content="Add song folder" HorizontalAlignment="Center" Click="AddFolder_Click"/></StackPanel>
              <Border Grid.Row="2" Background="#1C1B23" CornerRadius="10" Margin="0,12,0,0" Padding="16,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Your music belongs here." FontSize="12"/><TextBlock Text="Add your collection or drop a song folder here." FontSize="10" Foreground="#918A9A" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Content="↻" Style="{StaticResource QuietButton}" Padding="8,4" FontSize="20" Click="Refresh_Click" ToolTip="Refresh your song collection"/></Grid></Border>
            </Grid>
            <Border Grid.Column="1" Background="#1B1A23" CornerRadius="13" BorderBrush="#2B2835" BorderThickness="1" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,5"><StackPanel><TextBlock Text="U P  N E X T" Foreground="#9D92A9" FontSize="9" Margin="0,0,0,13"/><local:AlbumArt x:Name="SelectedArt" Height="152"/><TextBlock x:Name="SelectedTitle" Text="Choose your song" FontSize="20" FontWeight="SemiBold" Margin="0,17,0,0" TextWrapping="Wrap"/><TextBlock x:Name="SelectedArtist" FontSize="12" Foreground="#A49BAE" Margin="0,5,0,0" TextWrapping="Wrap"/><TextBlock x:Name="SelectedMeta" FontSize="11" Foreground="#A49BAE" Margin="0,17,0,0"/><TextBlock x:Name="SelectedGenre" FontSize="11" Foreground="#7F768B" Margin="0,6,0,0"/></StackPanel></ScrollViewer><StackPanel Grid.Row="1" Margin="0,12,0,0"><TextBlock x:Name="MicStatusText" Text="●  Set up your microphone" FontSize="11" Foreground="#DCC599" TextWrapping="Wrap" Margin="0,0,0,12"/><Button x:Name="SingButton" Content="Sing this song  →" Style="{StaticResource PrimaryButton}" Click="Sing_Click"/><TextBlock Text="Headphones make every note clearer." FontSize="9" Foreground="#7B7388" Margin="0,10,0,0" HorizontalAlignment="Center"/></StackPanel></Grid></Border>
          </Grid>
          <Grid Grid.Row="4" VerticalAlignment="Bottom"><TextBlock Text="●  Local audio, live pitch, your moment." FontSize="10" Foreground="#766E80"/><TextBlock Text="SPACE  pause     F11  full screen" FontSize="9" Foreground="#625B70" HorizontalAlignment="Right"/></Grid>
        </Grid>

        <Grid x:Name="StageView" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition x:Name="StageHeaderRow" Height="94"/><RowDefinition Height="*"/><RowDefinition x:Name="StageLyricsRow" Height="142"/><RowDefinition x:Name="StageStatsRow" Height="94"/><RowDefinition x:Name="StageControlsRow" Height="72"/></Grid.RowDefinitions>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="T H E  S T A G E" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="StageTitle" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="StageArtist" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,6,0,0"><Button Content="⤢" Style="{StaticResource QuietButton}" FontSize="23" Click="FullScreen_Click" ToolTip="Full screen (F11)"/><Button Content="←  Library" Margin="9,0,0,0" Click="Library_Click" ToolTip="End this performance and return to the library"/></StackPanel></Grid>
          <Border Grid.Row="1" Background="#17161F" BorderBrush="#302A3B" BorderThickness="1" CornerRadius="16" ClipToBounds="True"><Grid><local:PitchRoll x:Name="PitchCanvas" Margin="0,10,0,0"/><Border x:Name="CountdownOverlay" Background="#E6111018" CornerRadius="16"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock x:Name="CountdownText" Text="3" FontSize="85" FontWeight="Light" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/><TextBlock x:Name="CountdownCaption" Text="YOUR MOMENT STARTS NOW" FontSize="10" Foreground="#C1B7CA" HorizontalAlignment="Center"/></StackPanel></Border><Border x:Name="PauseOverlay" Background="#E6111018" CornerRadius="16" Visibility="Collapsed"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="Take a breath." FontSize="34" HorizontalAlignment="Center"/><TextBlock Text="Your stage will be right here." FontSize="14" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,9,0,19"/><Button Content="Resume performance  →" Style="{StaticResource PrimaryButton}" Click="Pause_Click"/></StackPanel></Border></Grid></Border>
          <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Stretch"><TextBlock x:Name="CurrentLyrics" Text="Follow the melody. Find your voice." FontSize="32" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="20,0"/><TextBlock x:Name="NextLyrics" FontSize="17" Foreground="#70677F" TextAlignment="Center" TextWrapping="Wrap" Margin="20,13,20,0"/></StackPanel>
          <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#211C29" CornerRadius="12" Padding="18,12" Margin="0,0,12,0"><Grid><StackPanel><TextBlock Text="SONG SCORE" FontSize="9" Foreground="#A99BB5"/><StackPanel Orientation="Horizontal" Margin="0,3,0,0"><TextBlock x:Name="LiveScore" Text="0.0" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/><TextBlock Text=" / 100" FontSize="12" Foreground="#8F819F" VerticalAlignment="Bottom" Margin="0,0,0,7"/></StackPanel></StackPanel><TextBlock x:Name="HitFeedback" Text="Ready" FontSize="13" Foreground="{StaticResource Lavender}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border><Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="12" Padding="18,12" Margin="0,0,12,0"><Grid><StackPanel><TextBlock Text="COMBO" FontSize="9" Foreground="#A99BB5"/><TextBlock x:Name="ComboText" Text="0 ×" FontSize="29" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel><TextBlock x:Name="AccuracyText" Text="0% accuracy" FontSize="12" Foreground="#A99BB5" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border><Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="12" Padding="18,12"><Grid><StackPanel><TextBlock Text="YOUR VOICE" FontSize="9" Foreground="#A99BB5"/><TextBlock x:Name="PitchText" Text="—" FontSize="29" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel><ProgressBar x:Name="StageMicLevel" Width="68" Height="5" Maximum=".20" Value="0" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border></Grid>
          <Grid Grid.Row="4" Margin="0,17,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions><Button x:Name="PauseButton" Content="Ⅱ" Style="{StaticResource QuietButton}" FontSize="20" Padding="5" Click="Pause_Click" ToolTip="Pause or resume (Space)"/><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,18,0"><ProgressBar x:Name="SongProgress" Maximum="100"/><TextBlock x:Name="StageHint" Text="Match the glowing bars. Golden notes count double. Sing in any octave." Foreground="#766D85" FontSize="10" Margin="0,9,0,0"/></StackPanel><TextBlock Grid.Column="2" x:Name="StageTime" Text="0:00 / 0:00" FontSize="11" Foreground="#AAA0B7" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,0,16"/></Grid>
        </Grid>

        <Grid x:Name="SettingsView" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="90"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="M A K E  Y O U R S E L F  H E A R D" Style="{StaticResource Eyebrow}"/><TextBlock Text="Studio setup" FontSize="30" FontWeight="SemiBold" Margin="0,6,0,0"/><TextBlock Text="A few small adjustments. A much better performance." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/></StackPanel><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,10,0">
          <Border Background="{StaticResource Panel}" CornerRadius="13" Padding="24" Margin="0,0,0,17"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,28,0"><TextBlock Text="Microphone" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Choose the microphone you want to sing into." Style="{StaticResource MutedText}" Margin="0,7,0,18"/><ComboBox x:Name="MicrophoneBox" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="Microphone_Changed" AutomationProperties.Name="Microphone"/><StackPanel Orientation="Horizontal" Margin="0,15,0,0"><Button x:Name="TestMicButton" Content="Test microphone" Style="{StaticResource PrimaryButton}" Click="TestMic_Click"/><Button Content="↻  Refresh" Style="{StaticResource QuietButton}" Margin="8,0,0,0" Click="RefreshMic_Click"/></StackPanel><TextBlock x:Name="MicTestStatus" Text="Start the test, then hum a steady note." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel><Border Grid.Column="1" Background="#211C2B" CornerRadius="10" Padding="20"><StackPanel><TextBlock Text="MIC CHECK" FontSize="9" Foreground="#A699B5"/><TextBlock x:Name="TunerNote" Text="—" FontSize="44" HorizontalAlignment="Center" Margin="0,11,0,0"/><TextBlock x:Name="TunerHz" Text="Ready to listen" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,4,0,19"/><ProgressBar x:Name="TestMicLevel" Maximum=".20"/><TextBlock x:Name="TunerQuality" Text="Your microphone is only active during a test or song." FontSize="10" Foreground="#8D809C" Margin="0,14,0,0" TextWrapping="Wrap" TextAlignment="Center"/></StackPanel></Border></Grid></Border>
          <Border Background="{StaticResource Panel}" CornerRadius="13" Padding="24" Margin="0,0,0,17"><StackPanel><TextBlock Text="Fine tune your sound" FontSize="19" FontWeight="SemiBold"/><Grid Margin="0,23,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,26,0"><TextBlock Text="Background noise filter" FontSize="13"/><TextBlock Text="Raise this if room noise registers as your voice." Style="{StaticResource MutedText}" Margin="0,6,0,0"/><TextBlock x:Name="GateValue" Foreground="{StaticResource Accent}" FontSize="11" Margin="0,8,0,0"/></StackPanel><Slider x:Name="GateSlider" Grid.Column="1" Minimum=".001" Maximum=".08" Value=".015" ValueChanged="AudioSetting_Changed" VerticalAlignment="Center" AutomationProperties.Name="Background noise threshold"/></Grid><Border Height="1" Background="#302A39" Margin="0,20"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,26,0"><TextBlock Text="Voice timing adjustment" FontSize="13"/><TextBlock Text="If the voice trail arrives late, move the slider to the right." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock x:Name="LatencyValue" Foreground="{StaticResource Accent}" FontSize="11" Margin="0,8,0,0"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><Slider x:Name="LatencySlider" Minimum="-300" Maximum="300" Value="0" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="AudioSetting_Changed" AutomationProperties.Name="Voice timing adjustment"/><Grid Margin="0,3,0,0"><TextBlock Text="−300 ms" FontSize="10" Foreground="#766B83"/><TextBlock Text="+300 ms" FontSize="10" Foreground="#766B83" HorizontalAlignment="Right"/></Grid></StackPanel></Grid><Border Height="1" Background="#302A39" Margin="0,20"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Music volume" FontSize="13"/><TextBlock x:Name="VolumeValue" Style="{StaticResource MutedText}" Margin="0,6,0,0"/></StackPanel><Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="1" Value=".7" ValueChanged="AudioSetting_Changed" VerticalAlignment="Center" AutomationProperties.Name="Music volume"/></Grid><Border Height="1" Background="#302A39" Margin="0,20"/><CheckBox x:Name="GuideCheck" Content="Play a melody guide to help me find each note" Checked="Guide_Changed" Unchecked="Guide_Changed" IsChecked="True"/><TextBlock Text="The guide plays the chart's melody quietly over your local audio." Style="{StaticResource MutedText}" Margin="30,7,0,0"/><Grid Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="145"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Melody practice key" FontSize="13"/><TextBlock Text="Shift the guide and target notes. The backing track stays in its original key." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,24,0"/></StackPanel><ComboBox x:Name="TransposeBox" Grid.Column="1" SelectionChanged="Transpose_Changed" AutomationProperties.Name="Melody practice key"/></Grid></StackPanel></Border>
          <Border Background="{StaticResource Panel}" CornerRadius="13" Padding="24" Margin="0,0,0,17"><StackPanel><Grid><TextBlock Text="Your song folders" FontSize="19" FontWeight="SemiBold"/><Button Content="＋  Add folder" HorizontalAlignment="Right" Click="AddFolder_Click" Padding="13,8"/></Grid><TextBlock Text="Songs are read directly from your folders. Your originals stay where they are." Style="{StaticResource MutedText}" Margin="0,9,0,15"/><ItemsControl x:Name="FolderList"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding}" FontSize="11" Foreground="#A398B2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/><Button Grid.Column="1" Content="Remove" Style="{StaticResource QuietButton}" Padding="9,4" FontSize="11" Click="RemoveFolder_Click"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Content="View import guide  ↗" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Padding="0,8" Click="ImportHelp_Click"/></StackPanel></Border>
          <TextBlock Text="Built for your own stage. Audio stays on this computer. Your voice is analyzed in memory and never recorded." FontSize="10" Foreground="#766B83" TextWrapping="Wrap" Margin="4,0,4,20"/>
        </StackPanel></ScrollViewer></Grid>

        <Grid x:Name="HistoryView" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="94"/><RowDefinition Height="118"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><StackPanel><TextBlock Text="E V E R Y  N O T E  C O U N T S" Style="{StaticResource Eyebrow}"/><TextBlock Text="Your performances" FontSize="30" FontWeight="SemiBold" Margin="0,6,0,0"/><TextBlock Text="A little better, every time you take the stage." Style="{StaticResource MutedText}" Margin="0,5,0,0"/></StackPanel><Button Content="Export results  ↗" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,9,0,0" Click="ExportHistory_Click"/></Grid><Grid Grid.Row="1" Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#251D2B" CornerRadius="12" Padding="20,17" Margin="0,0,14,0"><StackPanel><TextBlock Text="PERSONAL BEST" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="HistoryBest" Text="—" FontSize="32" Foreground="{StaticResource Accent}" Margin="0,5,0,0"/></StackPanel></Border><Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="12" Padding="20,17" Margin="0,0,14,0"><StackPanel><TextBlock Text="TIMES ON STAGE" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock x:Name="HistoryCount" Text="0" FontSize="32" Margin="0,5,0,0"/></StackPanel></Border><Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="12" Padding="20,17"><StackPanel><TextBlock Text="AVERAGE SCORE" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock x:Name="HistoryAverage" Text="—" FontSize="32" Foreground="{StaticResource Lavender}" Margin="0,5,0,0"/></StackPanel></Border></Grid><ListBox x:Name="HistoryList" Grid.Row="2" AutomationProperties.Name="Performance history"><ListBox.ItemTemplate><DataTemplate><Grid Margin="18,17"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding Artist}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Date, StringFormat={}{0:MMM d · HH:mm}}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding BestCombo, StringFormat={}{0}× best combo}" Foreground="#7E738E" FontSize="11" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="2" HorizontalAlignment="Right"><TextBlock Text="{Binding Score, StringFormat={}{0:0.0}}" FontSize="25" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/><TextBlock Text="OUT OF 100" FontSize="8" Foreground="#8B7D9A" HorizontalAlignment="Right"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Grid.Row="2" x:Name="EmptyHistory" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="Your first encore is waiting." FontSize="24"/><TextBlock Text="Finish a song to save your score here." Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,10,0,22"/><Button Content="Find your first song  →" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Click="Library_Click"/></StackPanel></Grid>
      </Grid>
    </Grid>

    <Border x:Name="Toast" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Background="#3B2A3A" BorderBrush="#6A4A5C" BorderThickness="1" CornerRadius="10" Padding="19,13" Margin="208,0,0,24" Visibility="Collapsed" MaxWidth="800"><TextBlock x:Name="ToastText" TextWrapping="Wrap" FontSize="13"/></Border>

    <Border x:Name="ResultOverlay" Grid.RowSpan="2" Background="#EE0E0D14" Visibility="Collapsed"><Border Background="#1E1925" BorderBrush="#4D344D" BorderThickness="1" CornerRadius="22" Width="595" Padding="42,34" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><TextBlock Text="T H A T  W A S  Y O U R  M O M E N T" Style="{StaticResource Eyebrow}" HorizontalAlignment="Center"/><TextBlock x:Name="ResultHeading" Text="What an encore." FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,13,0,0"/><TextBlock x:Name="ResultSong" Foreground="#A898B4" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" Margin="0,9,0,0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,19,0,5"><TextBlock x:Name="ResultScore" Text="0.0" FontSize="88" FontWeight="Light" Foreground="{StaticResource Accent}"/><TextBlock Text="/ 100" FontSize="20" Foreground="#897594" VerticalAlignment="Bottom" Margin="10,0,0,21"/></StackPanel><TextBlock x:Name="ResultMessage" Foreground="#C2B1CE" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,23"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="ResultPerfect" FontSize="24" Foreground="#C4B2FF" HorizontalAlignment="Center"/><TextBlock Text="PERFECT" FontSize="9" Foreground="#8E7E9C" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Name="ResultGood" FontSize="24" HorizontalAlignment="Center"/><TextBlock Text="GOOD" FontSize="9" Foreground="#8E7E9C" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock x:Name="ResultMiss" FontSize="24" HorizontalAlignment="Center"/><TextBlock Text="MISSED" FontSize="9" Foreground="#8E7E9C" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="3"><TextBlock x:Name="ResultCombo" FontSize="24" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/><TextBlock Text="BEST COMBO" FontSize="9" Foreground="#8E7E9C" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel></Grid><TextBlock x:Name="ResultBest" Text="Performance saved to your history." FontSize="11" Foreground="#A693B3" HorizontalAlignment="Center" Margin="0,27,0,23"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="15"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="Back to library" Click="ResultLibrary_Click"/><Button Grid.Column="2" Content="Sing it again  ↻" Style="{StaticResource PrimaryButton}" Click="SingAgain_Click"/></Grid></StackPanel></Border></Border>

    <Border x:Name="InfoOverlay" Grid.RowSpan="2" Background="#E9100E17" Visibility="Collapsed"><Border Width="580" MaxHeight="650" Background="#221C2B" BorderBrush="#5A3C5B" BorderThickness="1" CornerRadius="17" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="InfoTitle" Text="Information" FontSize="24" FontWeight="SemiBold"/><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,20,0,24"><TextBlock x:Name="InfoText" TextWrapping="Wrap" Foreground="#C0AFCA" FontSize="13" LineHeight="22"/></ScrollViewer><Button Grid.Row="2" Content="Got it" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Padding="27,11" Click="DismissInfo_Click"/></Grid></Border></Border>
  </Grid>
</Window>

