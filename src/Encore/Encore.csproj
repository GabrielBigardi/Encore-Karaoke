<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Encore</AssemblyName>
    <RootNamespace>Encore</RootNamespace>
    <Version>1.0.0</Version>
    <Product>Encore Karaoke</Product>
    <Description>Offline pitch-scoring karaoke. Your voice, center stage.</Description>
    <ApplicationIcon>Assets/encore.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <RuntimeIdentifiers>win-x64;win-x86;win-arm64</RuntimeIdentifiers>
    <RuntimeFrameworkVersion>8.0.31</RuntimeFrameworkVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Encore.Core/Encore.Core.csproj" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NVorbis" Version="0.10.4" />
    <PackageReference Include="NLayer" Version="1.16.0" />
    <EmbeddedResource Include="../../songs/**/*" Link="DemoSongs/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="Diagnostics/Fixtures/*.mp3" />
    <EmbeddedResource Include="Diagnostics/Fixtures/*.ogg" />
  </ItemGroup>
</Project>
